+static std::string diag_shape_str(const std::vector<int64_t>& shape) {
+    std::string s = "[";
+    for (size_t i = 0; i < shape.size(); ++i) {
+        if (i != 0) s += ",";
+        s += std::to_string(shape[i]);
+    }
+    s += "]";
+    return s;
+}
+
+static void diag_mv_stats(const char* tag, size_t idx, const std::shared_ptr<Tensor>& t) {
+    std::shared_ptr<Tensor> cpu = t->to(Device(DeviceType::CPU, 0));
+    float* d = cpu->data_ptr();
+    size_t n = cpu->numel();
+    double ss = 0.0;
+    float mn = 0.0f, mx = 0.0f;
+    bool any = false, nan = false, neg = false;
+    for (size_t j = 0; j < n; ++j) {
+        float v = d[j];
+        if (std::isnan(v)) { nan = true; continue; }
+        if (v < 0.0f) neg = true;
+        ss += (double)v * (double)v;
+        if (!any) { mn = v; mx = v; any = true; }
+        else { if (v < mn) mn = v; if (v > mx) mx = v; }
+    }
+    std::printf("DIAG-MV step=1 %s[%zu] shape=%s numel=%zu norm=%.6g min=%.6g max=%.6g nan=%d neg=%d\n",
+                tag, idx, diag_shape_str(t->shape).c_str(), n, std::sqrt(ss),
+                any ? (double)mn : 0.0, any ? (double)mx : 0.0, nan ? 1 : 0, neg ? 1 : 0);
+    std::fflush(stdout);
+}
