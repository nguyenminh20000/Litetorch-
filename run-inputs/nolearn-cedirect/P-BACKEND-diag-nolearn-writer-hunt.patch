+std::vector<std::pair<uintptr_t, size_t>> CachingAllocator::get_allocated_gpu_blocks() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    std::vector<std::pair<uintptr_t, size_t>> out;
+    out.reserve(allocated_gpu_blocks_.size());
+    for (const auto& kv : allocated_gpu_blocks_) {
+        out.emplace_back(reinterpret_cast<uintptr_t>(kv.first), kv.second.first);
+    }
+    return out;
+}
