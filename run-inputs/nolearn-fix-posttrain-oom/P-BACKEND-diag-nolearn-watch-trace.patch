+static void diag_grad_watch_print(const std::shared_ptr<Tensor>& t, const char* node_name) {
+    if (!t || !t->storage || !t->storage->gpu_data) return;
+    if (t->dtype != DataType::FP32) return;
+    if (t->device.type != DeviceType::GPU) return;
+    auto diag_backend = BackendDispatcher::get().get_backend();
+    if (diag_backend && diag_backend->is_available()) diag_backend->finish();
+    size_t diag_n = static_cast<size_t>(t->numel());
+    std::vector<float> diag_buf(diag_n);
+    rt_gpu_read(t->storage->gpu_data, diag_n * sizeof(float), diag_buf.data(), static_cast<size_t>(t->offset) * sizeof(float));
+    double diag_sq = 0.0;
+    float diag_min = std::numeric_limits<float>::max();
+    float diag_max = std::numeric_limits<float>::lowest();
+    int diag_nan = 0;
+    for (size_t i = 0; i < diag_n; ++i) {
+        float v = diag_buf[i];
+        if (v == v) {
+            if (v < diag_min) diag_min = v;
+            if (v > diag_max) diag_max = v;
+        } else {
+            ++diag_nan;
+        }
+        diag_sq += static_cast<double>(v) * static_cast<double>(v);
+    }
+    std::fprintf(stderr, "DIAG-GRAD-WATCH after=%s grad_norm=%.6g grad_min=%.6g grad_max=%.6g grad_nan=%d\n", node_name, std::sqrt(diag_sq), diag_min, diag_max, diag_nan);
+    std::fflush(stderr);
+}
