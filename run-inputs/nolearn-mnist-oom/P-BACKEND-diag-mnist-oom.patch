+size_t CachingAllocator::get_free_gpu_block_count() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t n = 0;
+    for (auto& pair : free_gpu_blocks_) n += pair.second.size();
+    return n;
+}
+
+size_t CachingAllocator::get_largest_free_gpu_block() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    size_t largest = 0;
+    for (auto& pair : free_gpu_blocks_) {
+        if (!pair.second.empty() && pair.first.second > largest) largest = pair.first.second;
+    }
+    return largest;
+}
